APP_ENV=development
# Docker listen address inside the backend container; Compose publishes it on
# 127.0.0.1 only and sets HTTP_TRUSTED_NETWORK=true. The host launcher uses
# HOST_HTTP_ADDR below (loopback by default).
HTTP_ADDR=:8080
DATABASE_URL=postgres://story:story@postgres:5432/story?sslmode=disable
FRONTEND_PORT=5173
BACKEND_PORT=8787
POSTGRES_DB=story
POSTGRES_USER=story
POSTGRES_PASSWORD=story
VITE_API_BASE_URL=

# Phase 6 StoryLLM baseline (runtime remains replaceable)
STORY_LLM_BASE_URL=http://host.docker.internal:8081
STORY_LLM_MODEL=Vikhr-Nemo-12B-Instruct-R-21-09-24-Q5_K_M
STORY_LLM_PROFILE=llamacpp-16k-kvq8
STORY_LLM_API_KEY=
SECRET_STORE_PATH=/data/secrets/provider-keys.json

# Optional on loopback, required for any listener reachable from other hosts.
# Every /internal/image-worker/* request must use this value as a Bearer
# token. Configure the same value in the userscript menu.
IMAGE_WORKER_TOKEN=
# Optional on loopback, required for any listener reachable from other hosts.
# When set, every route except /health* needs it: open
# http://<host>:<port>/api/v1/auth/session?token=<value> once in the browser
# (sets a session cookie) or send "Authorization: Bearer <value>".
API_ACCESS_TOKEN=
# Set to true only when the network already restricts who can reach the
# listener (e.g. a container port published on 127.0.0.1). Otherwise a
# non-loopback HTTP_ADDR without both tokens refuses to start.
HTTP_TRUSTED_NETWORK=false

# Experimental context path. It is measured and discarded; Writer/Canon use
# the existing context until the retrieval gates pass.
GENERATION_CONTEXT_SHADOW_V1=false
# Combined turn planner (one Flash-Lite call instead of interpreter/director/
# pacing) and provisional story text default to on; set false to disable.
GENERATION_TURN_PLANNER_V1=true
GENERATION_PROVISIONAL_BEAT_V1=true
GENERATION_JOURNAL_EVIDENCE_ISOLATION_V1=false
GENERATION_FAST_STATE_V1=false
# Per-attempt story worker budget (Go duration). Must exceed the largest story LLM timeout (safe-hybrid fast: 20m).
GENERATION_EXECUTION_TIMEOUT=25m
EMBEDDING_BASE_URL=http://host.docker.internal:8090
EMBEDDING_MODEL=deepvk/USER2-small

# Local image storage
MEDIA_ROOT=/data/generated
MEDIA_BASE_URL=/media

# Optional overrides for `make backend-dev` on the host
HOST_DATABASE_URL=postgres://story:story@127.0.0.1:5432/story?sslmode=disable
HOST_STORY_LLM_BASE_URL=http://127.0.0.1:8081
HOST_HTTP_ADDR=127.0.0.1:8787
# Vite bind host for `make frontend-dev`/start.sh. 0.0.0.0 exposes the UI (and
# the proxied API) to the LAN/WireGuard, so set API_ACCESS_TOKEN first.
HOST_FRONTEND_HOST=127.0.0.1
HOST_MEDIA_ROOT=../data/generated
HOST_SECRET_STORE_PATH=../data/secrets/provider-keys.json

# Independent browser requests are queued; each visible worker claims one at a time.
CHATGPT_BROWSER_PARALLELISM=32
CHATGPT_BRIDGE_MAX_ACTIVE=32

# Text by default; worker 0.4.1 verifies that no attachment is present.
# Set txt explicitly only when file uploads are desired.
CHATGPT_BRIDGE_INPUT_FORMAT=text
# Local text guard in UTF-16 units including the complete envelope, not model context.
CHATGPT_BRIDGE_MAX_TEXT_CHARS=65536
# Local transport guard for prompt plus attachment; not the model context window.
CHATGPT_BRIDGE_MAX_PROMPT_KIB=1024
