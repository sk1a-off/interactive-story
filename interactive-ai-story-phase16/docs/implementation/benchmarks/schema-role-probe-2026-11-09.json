      "output": "{\n  \"chapter\": {\n    \"goal\": \"Найти безопасный путь к северной башне\",\n    \"title\": \"Архив у реки\",\n    \"tone\": \"grounded adventure\"\n  },\n  \"immediateGoal\": \"Илья спокойно спрашивает Миру о начале обещанного прохода, а она дает ответ.\",\n  \"intent\": \"Спокойно спросить Миру, где начинается обещанный проход, и выслушать её ответ.\",\n  \"riskFlags\": [],\n  \"scene\": {\n    \"goal\": \"Разобраться с проходом через архив\",\n    \"locationId\": \"00000000-0000-4000-8000-000000008003\",\n    \"mood\": \"настороженное спокойствие\"\n  },\n  \"transition\": \"continue_scene\"\n}",
